# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
*.terraform.lock.hcl

# crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to
# password, private keys, and other secret. These
# control as they are data points wich are potential
# to change depending on the environment.
*.tfvars
*.tfvars.json

# ignore override files as they are usually used
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to
# !example_override.tf

# Include tfplan files to ignore the plan output
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc